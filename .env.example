# Copy to .env; replace placeholders locally. Never commit real values.

# The benchmark script automatically picks up any variable ending in _FEED_URL
# Add or remove providers below as needed.
OFFICIAL_FEED_URL='wss://feed.mainnet.chain.robinhood.com'
NODE1_FEED_URL='ws://ohio.robinhood-feeder.node1.me/feed/<YOUR_FEED_UUID>'
BLOXROUTE_FEED_URL='wss://az1.feed.mainnet.chain.robinhood.blxrbdn.com/ws/<YOUR_TOKEN>'
BLOCKRAZOR_FEED_URL='wss://us.robinhood.blockrazor.io/<YOUR_TOKEN>'
FIRSTLIGHT_FEED_URL='wss://blocks.first-light.stream/<YOUR_API_KEY>'

# Directories and Landing Configuration
NODE1_FEED_BENCH_ROOT='./data/feed'
LANDING_DATA_DIR='./data/landing'
NODE1_UUID_FILE='./secrets/landing-uuid'
# Three current official sequencer IPs, preserving TLS Host/SNI verification.
SEQUENCER_IPS='<IP_1>,<IP_2>,<IP_3>'